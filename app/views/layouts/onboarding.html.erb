<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Dev Registry" %></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
</head>
<body class="antialiased pu-min-h-viewport bg-[var(--pu-body)]">
  <main class="pu-min-h-viewport flex flex-col items-center justify-center px-4 py-8 mx-auto">
    <div class="w-full sm:max-w-lg bg-[var(--pu-card-bg)] border border-[var(--pu-card-border)] rounded-[var(--pu-radius-lg)]"
         style="box-shadow: var(--pu-shadow-lg)">
      <div class="p-6 space-y-6 sm:p-8">
        <%= yield %>
      </div>
    </div>
  </main>
</body>
</html>
