<% content_for :title, "Create your developer profile" %>
<% label_class = "block mb-2 text-sm font-medium text-[var(--pu-text)]" %>

<div class="space-y-1">
  <h1 class="text-xl font-bold text-[var(--pu-text)]">Create your developer profile</h1>
  <p class="text-sm text-[var(--pu-text-muted)]">Add skills, experience and projects once it's created.</p>
</div>

<%= form_with model: @profile, scope: :developers_profile, url: developer_profile_setup_path, class: "space-y-4" do |f| %>
  <%= render "shared/form_errors", model: @profile %>
  <%= render "developer_profile_setups/fields", f:, label_class: %>

  <div class="flex gap-3">
    <%= f.submit "Create profile", class: "pu-btn pu-btn-md pu-btn-primary" %>
    <%= link_to "Cancel", dashboard_portal.root_path, class: "pu-btn pu-btn-md pu-btn-outline" %>
  </div>
<% end %>
