<% profile = @profile %>
<% content_for :title, "#{profile.name} (@#{profile.handle})" %>
<% content_for :description, [profile.headline, profile.location].compact_blank.join(" · ").presence || "#{profile.name} on Dev Registry" %>
<% content_for :noindex, true unless profile.visible_to_everyone? %>
<% contact_visible = profile.contact_visible_to?(current_user) %>
<% links = [
     [Phlex::TablerIcons::BrandGithub, profile.github_url],
     [Phlex::TablerIcons::BrandLinkedin, profile.linkedin_url],
     [Phlex::TablerIcons::BrandX, profile.x_url],
     [Phlex::TablerIcons::World, profile.website_url]
   ].select { |_, url| url.present? } %>

<div class="mx-auto max-w-5xl px-4 py-10">
  <% if @own %>
    <div class="mb-6 flex flex-col gap-3 rounded-xl border-2 border-[#111] bg-[#f5e642] px-5 py-3 text-sm sm:flex-row sm:items-center sm:justify-between">
      <span>
        This is your profile.
        <% if profile.visible_to_hidden? %>It's <strong>hidden</strong>: only you can see it.
        <% elsif profile.visible_to_members? %>It's visible to <strong>signed-in members</strong> only.
        <% else %>It's <strong>public</strong>.<% end %>
      </span>
      <%= link_to "Edit profile", developer_portal_edit_profile_path(profile), class: "shrink-0 rounded-full border-2 border-[#111] bg-white px-4 py-1.5 font-semibold" %>
    </div>
  <% end %>

  <section class="overflow-hidden rounded-2xl border-2 border-[#111] bg-white shadow-[8px_8px_0_#e8117f]">
    <div class="flex h-24 items-start justify-end border-b-2 border-[#111] bg-[#f5e642] px-5 py-3 font-mono text-sm font-bold">@<%= profile.handle %></div>
    <div class="px-6 pb-6">
      <div class="-mt-10 flex items-end justify-between gap-4">
        <%= render InitialsAvatar.new(name: profile.name, seed: profile.handle, size: :xl, class: "ring-4 ring-white") %>
        <button type="button" data-controller="clipboard" data-clipboard-text-value="<%= request.original_url %>" data-action="clipboard#copy"
                class="rounded-full border-2 border-[#111] bg-white px-4 py-1.5 text-sm font-semibold">
          <span data-clipboard-target="label">Copy link</span>
        </button>
      </div>
      <div class="mt-4 space-y-2">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1 class="font-display text-4xl"><%= profile.name %></h1>
          <%= availability_pill(profile) %>
        </div>
        <% if profile.headline.present? %><p class="text-lg text-[#555]"><%= profile.headline %></p><% end %>
        <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[#555]">
          <% if profile.location.present? %><span class="flex items-center gap-1"><%= render Phlex::TablerIcons::MapPin.new(class: "h-4 w-4") %> <%= profile.location %></span><% end %>
          <% if profile.remote_ok? %><span>Open to remote</span><% end %>
          <% if profile.open_to_relocation? %><span>Open to relocating</span><% end %>
          <% if profile.seniority %><span><%= profile.seniority.humanize %><%= " · #{pluralize(profile.years_experience, "year")} experience" if profile.years_experience %></span><% end %>
        </p>
      </div>
    </div>
  </section>

  <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[2fr_1fr]">
    <div class="min-w-0 space-y-10">
      <% if profile.bio.present? %>
        <section>
          <h2 class="font-display text-3xl">About</h2>
          <div class="prose mt-4 max-w-none prose-a:text-[#d10f72]"><%= render_markdown(profile.bio) %></div>
        </section>
      <% end %>

      <section>
        <h2 class="font-display text-3xl">Experience</h2>
        <% if @experiences.any? %>
          <ol class="relative ml-2 mt-6 space-y-6 border-l-2 border-[#111]">
            <% @experiences.each do |experience| %>
              <li class="ml-6">
                <span class="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full border-2 border-[#111] <%= experience.current? ? "bg-[#e8117f]" : "bg-white" %>"></span>
                <p class="font-semibold"><%= experience.title %></p>
                <p class="text-sm text-[#555]"><%= [experience.company_name, experience.location.presence].compact.join(" · ") %></p>
                <p class="text-xs text-[#6b6b6b]"><%= experience.started_on.strftime("%b %Y") %> – <%= experience.ended_on&.strftime("%b %Y") || "Present" %></p>
                <% if experience.description.present? %><div class="prose prose-sm mt-2 max-w-none"><%= render_markdown(experience.description) %></div><% end %>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="mt-4 text-[#555]">No experience added yet.</p>
        <% end %>
      </section>
    </div>

    <aside class="space-y-8">
      <section class="rounded-xl border-2 border-[#111] bg-white p-5">
        <h2 class="font-semibold">Skills</h2>
        <% if @profile_skills.any? %>
          <ul class="mt-4 flex flex-wrap gap-2">
            <% @profile_skills.each do |profile_skill| %>
              <li>
                <%= link_to developers_directory_path(skill: profile_skill.skill.slug), class: "inline-flex items-center gap-1.5 rounded-full border-2 border-[#111] bg-[#f5f2e8] px-3 py-1 text-sm hover:bg-[#f5e642]" do %>
                  <span class="font-medium"><%= profile_skill.skill.name %></span>
                  <% details = [profile_skill.level&.humanize, (pluralize(profile_skill.years, "yr") if profile_skill.years)].compact %>
                  <% if details.any? %><span class="text-xs text-[#555]"><%= details.join(" · ") %></span><% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-3 text-sm text-[#555]">No skills added yet.</p>
        <% end %>
      </section>

      <section class="rounded-xl border-2 border-[#111] bg-white p-5">
        <h2 class="font-semibold">Contact</h2>
        <% if contact_visible && (profile.contact_email.present? || profile.phone.present?) %>
          <ul class="mt-4 space-y-2 text-sm">
            <% if profile.contact_email.present? %>
              <li class="flex items-center gap-2"><%= render Phlex::TablerIcons::Mail.new(class: "h-4 w-4 text-[#6b6b6b]") %> <%= mail_to profile.contact_email, class: "text-[#d10f72] hover:underline" %></li>
            <% end %>
            <% if profile.phone.present? %>
              <li class="flex items-center gap-2"><%= render Phlex::TablerIcons::Phone.new(class: "h-4 w-4 text-[#6b6b6b]") %> <%= link_to profile.phone, "tel:#{profile.phone}", class: "text-[#d10f72] hover:underline" %></li>
            <% end %>
          </ul>
        <% elsif !contact_visible && profile.contact_visible_to_members? && current_user.nil? %>
          <p class="mt-3 text-sm text-[#555]"><%= link_to "Log in", rodauth(:user).login_path, class: "font-semibold text-[#d10f72] hover:underline" %> to see contact details.</p>
        <% else %>
          <p class="mt-3 text-sm text-[#555]">Contact details aren't shared publicly.</p>
        <% end %>

        <% if links.any? %>
          <ul class="mt-4 space-y-2 border-t border-[#e0ddd4] pt-4 text-sm">
            <% links.each do |icon, url| %>
              <li class="flex min-w-0 items-center gap-2">
                <%= render icon.new(class: "h-4 w-4 shrink-0 text-[#6b6b6b]") %>
                <%= link_to url.sub(%r{\Ahttps?://(www\.)?}, ""), url, target: "_blank", rel: "nofollow noopener", class: "truncate text-[#d10f72] hover:underline" %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>

      <% if @posts.any? %>
        <section class="rounded-xl border-2 border-[#111] bg-white p-5">
          <h2 class="font-semibold">Posted by <%= @profile.name.split.first %></h2>
          <ul class="mt-3 space-y-3">
            <% @posts.each do |post| %>
              <li>
                <%= link_to post.title, public_job_path(post), class: "block text-sm font-semibold text-[#d10f72] hover:underline" %>
                <span class="text-xs text-[#6b6b6b]"><%= [post.type_label, post.pay].compact.join(" · ") %></span>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </aside>
  </div>
</div>
