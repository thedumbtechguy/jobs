<% content_for :title, "Not found" %>
<% content_for :noindex, true %>
<section class="mx-auto max-w-2xl px-4 py-28 text-center">
  <p class="font-display text-7xl text-[#d10f72]">404</p>
  <h1 class="mt-4 font-display text-4xl">Nothing to see here.</h1>
  <p class="mt-4 text-[#555]">This page doesn't exist, or it isn't visible to you. Some profiles and jobs are only visible to signed-in members.</p>
  <div class="mt-8 flex justify-center gap-3">
    <%= link_to "Browse developers", developers_directory_path, class: "rounded-full border-2 border-[#111] bg-white px-6 py-3 font-semibold" %>
    <%= link_to "Browse jobs", public_jobs_path, class: "rounded-full border-2 border-[#111] bg-[#d10f72] px-6 py-3 font-semibold text-white" %>
  </div>
</section>
