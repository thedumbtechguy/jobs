<% if @pages > 1 %>
  <nav class="mt-10 flex items-center justify-center gap-3" aria-label="Pagination">
    <% if @page > 1 %>
      <%= link_to "← Previous", url_for(filter_params(page: @page - 1)), class: "rounded-full border-2 border-[#111] bg-white px-5 py-2 text-sm font-semibold" %>
    <% end %>
    <span class="text-sm text-[#555]">Page <%= @page %> of <%= @pages %></span>
    <% if @page < @pages %>
      <%= link_to "Next →", url_for(filter_params(page: @page + 1)), class: "rounded-full border-2 border-[#111] bg-white px-5 py-2 text-sm font-semibold" %>
    <% end %>
  </nav>
<% end %>
