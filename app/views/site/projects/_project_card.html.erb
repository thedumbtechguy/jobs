<% skills = project.skills.map(&:name).sort.first(4) %>
<%# Hidden profiles stay off cards, like everywhere else. %>
<% people = [project.owner, *project.confirmed_contributors.map(&:profile).select { _1.visible_to?(current_user) }].uniq.first(5) %>
<%= link_to public_project_path(project.slug), class: "group flex h-full flex-col rounded-xl border-2 border-[#111] bg-white p-5 transition-transform hover:-translate-y-0.5" do %>
  <span class="flex items-start justify-between gap-3">
    <span class="font-display text-2xl leading-tight group-hover:text-[#d10f72]"><%= project.title %></span>
    <% if project.ongoing? %><span class="shrink-0 rounded-full bg-[#dcfce7] px-2.5 py-0.5 text-xs font-semibold text-[#166534]">Ongoing</span><% end %>
  </span>
  <% if project.summary.present? %><span class="mt-2 text-sm text-[#555]"><%= project.summary %></span><% end %>
  <% if skills.any? %>
    <span class="mt-3 flex flex-wrap gap-1.5"><% skills.each do |skill| %><%= pill(skill) %><% end %></span>
  <% end %>
  <span class="mt-auto flex items-center gap-2 pt-4">
    <span class="flex -space-x-1.5">
      <% people.each do |person| %>
        <%= render InitialsAvatar.new(name: person.name, seed: person.handle, size: :sm, class: "ring-2 ring-white") %>
      <% end %>
    </span>
    <span class="truncate text-xs text-[#6b6b6b]">
      <%= project.owner.name %><%= " + #{pluralize(people.size - 1, "other")}" if people.size > 1 %>
    </span>
  </span>
<% end %>
