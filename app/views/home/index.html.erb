<% content_for :title, "Dev Registry · DevCongress" %>
<% signed_in = rodauth(:user).logged_in? %>
<% join_path = signed_in ? "/dashboard" : rodauth(:user).create_account_path %>
<% roles = ["Backend Engineer", "Frontend Developer", "Mobile Developer", "Product Designer", "Data Scientist", "DevOps Engineer", "Tech Lead", "QA Engineer", "Founder", "Product Manager", "ML Engineer", "Security Engineer"] %>

<div class="min-h-screen bg-[#f5f2e8] text-[#111] antialiased">
  <%# Nav %>
  <header class="sticky top-0 z-20 border-b-2 border-[#111] bg-[#f5f2e8]/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
      <a href="<%= root_path %>" class="flex items-center gap-3" aria-label="Dev Registry home">
        <%= image_tag "brand/devcongress-wordmark.png", alt: "DevCongress", class: "h-6 w-auto sm:h-7" %>
        <span class="hidden rounded-full border-2 border-[#111] px-2 py-0.5 font-mono text-xs font-bold sm:inline">registry</span>
      </a>
      <nav class="hidden items-center gap-6 text-sm font-medium text-[#555] md:flex">
        <a href="#developers" class="hover:text-[#111]">Developers</a>
        <a href="#jobs" class="hover:text-[#111]">Jobs</a>
        <a href="#companies" class="hover:text-[#111]">For companies</a>
      </nav>
      <div class="flex items-center gap-2">
        <% if signed_in %>
          <%= link_to "Dashboard", "/dashboard", class: "rounded-full border-2 border-[#111] bg-[#d10f72] px-5 py-2 text-sm font-semibold text-white" %>
        <% else %>
          <%= link_to "Log in", rodauth(:user).login_path, class: "rounded-full border-2 border-[#111] bg-white px-4 py-2 text-sm font-semibold sm:px-5" %>
          <%= link_to "Join", rodauth(:user).create_account_path, class: "rounded-full border-2 border-[#111] bg-[#d10f72] px-4 py-2 text-sm font-semibold text-white sm:px-5" %>
        <% end %>
      </div>
    </div>
  </header>

  <main>
    <%# Hero %>
    <section class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-4 py-16 lg:grid-cols-[1.15fr_1fr] lg:py-24">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#555]">The DevCongress developer registry</p>
        <h1 class="mt-5 font-display text-5xl leading-[1.05] sm:text-6xl lg:text-7xl">
          Africa's builders, <span class="text-[#d10f72]">in one place</span>.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-[#555]">
          A profile for every developer in the community: what you know, what you've shipped, and whether you're
          open to work. Companies come here to hire.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <%= link_to (signed_in ? "Go to your dashboard" : "Create your profile"), join_path,
                class: "rounded-full border-2 border-[#111] bg-[#d10f72] px-8 py-3.5 text-center font-semibold text-white shadow-[4px_4px_0_#111] transition-transform hover:-translate-y-0.5" %>
          <a href="#companies" class="rounded-full border-2 border-[#111] bg-white px-8 py-3.5 text-center font-semibold transition-transform hover:-translate-y-0.5">I'm hiring</a>
        </div>
        <p class="mt-5 text-sm text-[#6b6b6b]">Free, always. No paywalls, no gatekeeping.</p>
      </div>

      <%# Live preview: the newest listed developers %>
      <div class="rounded-2xl border-2 border-[#111] bg-white shadow-[8px_8px_0_#e8117f]">
        <div class="flex items-center justify-between rounded-t-[14px] border-b-2 border-[#111] bg-[#f5e642] px-5 py-3">
          <span class="font-mono text-sm font-bold">dev:registry{}; — newest builders</span>
          <span class="flex items-center gap-1.5 text-xs font-semibold text-[#d10f72]"><span class="h-2 w-2 rounded-full bg-[#e8117f]"></span> Live</span>
        </div>
        <div class="space-y-3 p-5">
          <% if @developers.any? %>
            <% @developers.first(3).each do |developer| %>
              <%= render "home/developer_card", developer: %>
            <% end %>
          <% else %>
            <p class="py-10 text-center text-[#555]">Be the first builder in the registry.</p>
          <% end %>
        </div>
      </div>
    </section>

    <%# Stats %>
    <section class="mx-auto max-w-6xl px-4 pb-16">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        <% [
             [@stats[:developers], "Developers listed", "Searchable profiles with skills and experience."],
             [@stats[:companies], "Companies", "Teams hiring from the community."],
             [@stats[:open_jobs], "Open jobs", "Live roles you can apply to today."]
           ].each do |count, label, body| %>
          <div class="rounded-xl border-2 border-[#111] bg-white p-6 shadow-[6px_6px_0_#e8117f]">
            <p class="font-display text-6xl leading-none text-[#d10f72]"><%= number_with_delimiter(count) %></p>
            <p class="mt-3 text-lg font-semibold"><%= label %></p>
            <p class="mt-1 text-sm text-[#555]"><%= body %></p>
          </div>
        <% end %>
      </div>
    </section>

    <%# Roles band %>
    <div class="overflow-hidden border-y-2 border-[#111] bg-[#f5e642] py-4" aria-hidden="true">
      <div class="dc-marquee flex w-max gap-10 whitespace-nowrap font-display text-2xl">
        <% (roles * 2).each do |role| %>
          <span><%= role %> <span class="text-[#d10f72]">✦</span></span>
        <% end %>
      </div>
    </div>

    <%# Two audiences %>
    <section class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-20 md:grid-cols-2" id="companies">
      <% [
           ["For developers", "Get found for the work you actually do.", [
             ["Make your profile", "Skills with years and level, your experience, and your links."],
             ["Say if you're looking", "Open to work, open to offers, or just here to be counted."],
             ["Apply in one click", "Send your profile to companies, and track every application."]
           ], (signed_in ? "Open your dashboard" : "Create your profile")],
           ["For companies", "Hire from a community that ships.", [
             ["Set up your company", "Invite recruiters to work on hiring with you."],
             ["Post a job", "Take applications here, link to your careers page, or both."],
             ["Review applicants", "Move people through reviewing, shortlisted and hired."]
           ], (signed_in ? "Set up a company" : "Start hiring")]
         ].each do |eyebrow, title, steps, cta| %>
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#555]"><%= eyebrow %></p>
          <h2 class="mt-3 font-display text-4xl leading-tight"><%= title %></h2>
          <ol class="mt-8 divide-y-2 divide-[#111] border-y-2 border-[#111]">
            <% steps.each_with_index do |(step, body), index| %>
              <li class="flex gap-5 py-5">
                <span class="font-display text-2xl text-[#d10f72]">0<%= index + 1 %></span>
                <div>
                  <p class="font-semibold"><%= step %></p>
                  <p class="mt-1 text-sm text-[#555]"><%= body %></p>
                </div>
              </li>
            <% end %>
          </ol>
          <%= link_to cta, (signed_in && eyebrow == "For companies") ? "/setup/company/new" : join_path,
                class: "mt-6 inline-block rounded-full border-2 border-[#111] bg-white px-6 py-3 font-semibold transition-transform hover:-translate-y-0.5" %>
        </div>
      <% end %>
    </section>

    <%# Jobs + skills %>
    <section class="border-t-2 border-[#111] bg-white" id="jobs">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-20 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#555]">Hiring now</p>
          <h2 class="mt-3 font-display text-4xl">Latest jobs</h2>
          <% if @jobs.any? %>
            <ul class="mt-8 space-y-3">
              <% @jobs.each do |job| %>
                <li>
                  <%= link_to join_path, class: "group flex items-center gap-4 rounded-xl border-2 border-[#111] bg-[#f5f2e8] p-4 transition-transform hover:-translate-y-0.5" do %>
                    <%= render InitialsAvatar.new(name: job.company.name, seed: job.company.slug, shape: :square) %>
                    <span class="min-w-0 flex-1">
                      <span class="block truncate font-semibold group-hover:text-[#d10f72]"><%= job.title %></span>
                      <span class="block truncate text-sm text-[#555]"><%= [job.company.name, job.location.presence, job.employment_type.humanize].compact.join(" · ") %></span>
                    </span>
                    <% if job.salary_range %><span class="hidden shrink-0 text-sm font-medium sm:block"><%= job.salary_range %></span><% end %>
                    <span class="shrink-0 text-xl text-[#d10f72]" aria-hidden="true">→</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-8 rounded-xl border-2 border-dashed border-[#c9c5b8] p-8 text-center text-[#555]">No open jobs yet. Hiring? Post the first one.</p>
          <% end %>
        </div>

        <div id="developers">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#555]">The community knows</p>
          <h2 class="mt-3 font-display text-4xl">Top skills</h2>
          <% if @top_skills.any? %>
            <div class="mt-8 flex flex-wrap gap-2">
              <% @top_skills.each do |name, count| %>
                <span class="rounded-full border-2 border-[#111] bg-[#f5f2e8] px-4 py-1.5 text-sm font-medium">
                  <%= name %> <span class="text-[#d10f72]"><%= count %></span>
                </span>
              <% end %>
            </div>
          <% else %>
            <p class="mt-8 text-[#555]">Skills appear here as developers add them.</p>
          <% end %>
          <% if @developers.size > 3 %>
            <div class="mt-10 space-y-3">
              <% @developers.drop(3).each do |developer| %>
                <%= render "home/developer_card", developer: %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <%# Closing CTA %>
    <section class="bg-[#111] text-white">
      <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-8 px-4 py-20 md:flex-row md:items-center">
        <h2 class="max-w-2xl font-display text-4xl leading-tight sm:text-5xl">
          Builders helping builders, <span class="text-[#f5e642]">since 2015</span>.
        </h2>
        <%= link_to (signed_in ? "Go to your dashboard" : "Join the registry"), join_path,
              class: "shrink-0 rounded-full border-2 border-white bg-[#d10f72] px-8 py-3.5 font-semibold text-white" %>
      </div>
    </section>
  </main>

  <footer class="border-t-2 border-[#111]">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-[#555] sm:flex-row">
      <p>A <a href="https://devcongress.org" class="font-semibold text-[#111] hover:text-[#d10f72]">DevCongress</a> project. Africa's home for builders.</p>
      <div class="flex gap-6">
        <a href="https://devcongress.org" class="hover:text-[#111]">devcongress.org</a>
        <%= link_to "Log in", signed_in ? "/dashboard" : rodauth(:user).login_path, class: "hover:text-[#111]" %>
      </div>
    </div>
  </footer>
</div>
