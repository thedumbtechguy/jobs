<% content_for :title, "Dev Registry · DevCongress" %>
<% signed_in = rodauth(:user).logged_in? %>

<div class="min-h-screen bg-[#f5f2e8] text-[#111]">
  <header class="border-b-2 border-[#111]">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
      <a href="<%= root_path %>" class="flex items-center gap-3">
        <%= image_tag "brand/devcongress-wordmark.png", alt: "DevCongress", class: "h-7 w-auto" %>
        <span class="hidden font-mono text-sm font-semibold sm:inline">registry</span>
      </a>
      <nav class="flex items-center gap-3">
        <% if signed_in %>
          <%= link_to "Dashboard", "/dashboard", class: "rounded-full border-2 border-[#111] bg-[#e8117f] px-5 py-2 text-sm font-semibold text-white" %>
        <% else %>
          <%= link_to "Log in", rodauth(:user).login_path, class: "rounded-full border-2 border-[#111] bg-white px-5 py-2 text-sm font-semibold" %>
          <%= link_to "Join", rodauth(:user).create_account_path, class: "rounded-full border-2 border-[#111] bg-[#d10f72] px-5 py-2 text-sm font-semibold text-white" %>
        <% end %>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4">
    <section class="py-20 text-center sm:py-28">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#555]">The DevCongress developer registry</p>
      <h1 class="mx-auto mt-6 max-w-4xl font-display text-5xl leading-[1.1] sm:text-7xl">
        Find Africa's builders. Show what <span class="text-[#d10f72]">you've built</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-[#555]">
        A catalogue of the developers in our community: their skills, their work and where they want to go next.
        Companies hire here too.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <% if signed_in %>
          <%= link_to "Go to your dashboard", "/dashboard", class: "w-full rounded-full border-2 border-[#111] bg-[#d10f72] px-10 py-4 text-base font-semibold text-white sm:w-auto" %>
        <% else %>
          <%= link_to "Create your profile", rodauth(:user).create_account_path, class: "w-full rounded-full border-2 border-[#111] bg-[#d10f72] px-10 py-4 text-base font-semibold text-white sm:w-auto" %>
          <%= link_to "I'm hiring", rodauth(:user).create_account_path, class: "w-full rounded-full border-2 border-[#111] bg-white px-10 py-4 text-base font-semibold sm:w-auto" %>
        <% end %>
      </div>
    </section>

    <section class="grid gap-8 pb-24 md:grid-cols-3">
      <% [
           ["Profiles", "List your skills, experience and links, and say whether you're open to work."],
           ["Jobs", "Companies post roles. Apply with your profile, or through their own link."],
           ["Community", "Built by DevCongress: no paywalls, no gatekeeping, just builders helping builders."]
         ].each_with_index do |(title, body), index| %>
        <div class="rounded-xl border-2 border-[#111] bg-white p-6 shadow-[6px_6px_0_#e8117f]">
          <p class="font-display text-4xl text-[#d10f72]">0<%= index + 1 %></p>
          <h2 class="mt-3 text-xl font-semibold"><%= title %></h2>
          <p class="mt-2 text-[#555]"><%= body %></p>
        </div>
      <% end %>
    </section>
  </main>
</div>
