<% content_for :title, "Set up a company" %>
<% label_class = "block mb-2 text-sm font-medium text-[var(--pu-text)]" %>

<div class="space-y-1">
  <h1 class="text-xl font-bold text-[var(--pu-text)]">Set up a company</h1>
  <p class="text-sm text-[var(--pu-text-muted)]">You'll be its owner and can invite recruiters. Your personal listing stays as it is.</p>
</div>

<%= form_with model: @company, url: company_setup_path, class: "space-y-4" do |f| %>
  <%= render "shared/form_errors", model: @company %>

  <div>
    <%= f.label :name, class: label_class %>
    <%= f.text_field :name, class: "pu-input w-full", required: true, autofocus: true %>
  </div>
  <div>
    <%= f.label :website, class: label_class %>
    <%= f.url_field :website, class: "pu-input w-full", placeholder: "https://" %>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :city, class: label_class %>
      <%= f.text_field :city, class: "pu-input w-full" %>
    </div>
    <div>
      <%= f.label :country, class: label_class %>
      <%= f.text_field :country, class: "pu-input w-full" %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= f.submit "Create company", class: "pu-btn pu-btn-md pu-btn-primary" %>
    <%= link_to "Cancel", dashboard_portal.root_path, class: "pu-btn pu-btn-md pu-btn-outline" %>
  </div>
<% end %>
