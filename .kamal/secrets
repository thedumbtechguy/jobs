# Secrets for Kamal, read from the environment of the machine running `kamal deploy`.
# Every value is an env var; nothing is read from Rails credentials.
# Never commit real values. A password manager adapter works too, e.g.
#   SECRETS=$(kamal secrets fetch --adapter 1password --account acct --from Vault/Item SECRET_KEY_BASE ...)
#   SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE ${SECRETS})

SECRET_KEY_BASE=$SECRET_KEY_BASE
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT

SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD

LITESTREAM_ACCESS_KEY_ID=$LITESTREAM_ACCESS_KEY_ID
LITESTREAM_SECRET_ACCESS_KEY=$LITESTREAM_SECRET_ACCESS_KEY
