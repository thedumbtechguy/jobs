# Production config for bin/deploy. Copy to `.env.production` and fill in.
# `.env.production` is gitignored — never commit the real values.
#
#   cp .env.production.template .env.production
#
# Host, URL and mail sender are fixed in config/deploy.yml, not here.

# ghcr.io token that can push to the devcongress org (write:packages).
KAMAL_REGISTRY_PASSWORD=

# RAILS_MASTER_KEY is read from config/master.key (gitignored) by bin/deploy.
# Set it here only if you keep the key somewhere else.
# RAILS_MASTER_KEY=

# `bin/rails db:encryption:init`. Encrypts invite tokens; never rotate casually.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# == Outgoing mail (Resend) ==
# A sending-access API key. devcongress.org must be a verified domain in Resend.
RESEND_API_KEY=

# == Litestream (replica of the primary database on Backblaze B2) ==
LITESTREAM_REPLICA_BUCKET=devcongress-connect
LITESTREAM_REPLICA_REGION=eu-central-003
LITESTREAM_REPLICA_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# An application key limited to the bucket, with Read and Write: keyID here,
# applicationKey below.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# == Social sign-in (optional) ==
# Callbacks: https://connect.devcongress.org/users/auth/google/callback
#            https://connect.devcongress.org/users/auth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
