<%= render Plutonium::UI::Layout::IconRail.new(
      menu: Phlexi::Menu::Builder.new do |m|
        m.item "Overview", url: root_path, icon: Phlex::TablerIcons::LayoutDashboard
        m.item "Jobs", url: resource_url_for(Hiring::JobPost, parent: nil), icon: Phlex::TablerIcons::Briefcase
        m.item "Applicants", url: resource_url_for(Hiring::JobApplication, parent: nil), icon: Phlex::TablerIcons::UserCheck
        m.item "Company", url: resource_url_for(Company, parent: nil), icon: Phlex::TablerIcons::Building
        m.item "Members", url: resource_url_for(CompanyUser, parent: nil), icon: Phlex::TablerIcons::Users
        m.item "Invitations", url: resource_url_for(Invites::CompanyUserInvite, parent: nil), icon: Phlex::TablerIcons::Mail
        m.item "Home", url: home_dashboard_path, icon: Phlex::TablerIcons::Home
      end
    ) do |rail| %>
  <% rail.with_brand do %>
    <%= resource_logo_tag(classname: "h-7 w-auto") %>
  <% end %>
<% end %>
