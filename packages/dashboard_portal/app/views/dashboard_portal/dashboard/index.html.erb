<% developer = current_user.developer %>
<% companies = current_user.companies.order(:name) %>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-[var(--pu-text)]">Hi, <%= developer.name %></h1>
    <p class="text-[var(--pu-text-muted)]"><%= developer.headline.presence || "Add a headline so people know what you do." %></p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="pu-card">
      <div class="pu-card-body space-y-4">
        <div>
          <h3 class="font-semibold text-[var(--pu-text)]">Your listing</h3>
          <p class="text-sm text-[var(--pu-text-muted)]">
            @<%= developer.handle %> · <%= developer.listed? ? "Listed in the directory" : "Not listed" %>
          </p>
        </div>
        <div class="flex gap-2 pt-2 border-t border-[var(--pu-border-muted)]">
          <a href="<%= resource_url_for(Developer, parent: nil) %>" class="pu-btn pu-btn-sm pu-btn-primary">View</a>
          <a href="<%= resource_url_for(Developer, parent: nil, action: :edit) %>" class="pu-btn pu-btn-sm pu-btn-outline">Edit</a>
        </div>
      </div>
    </div>

    <div class="pu-card">
      <div class="pu-card-body space-y-4">
        <div>
          <h3 class="font-semibold text-[var(--pu-text)]">Your companies</h3>
          <% if companies.any? %>
            <ul class="mt-2 space-y-1 text-sm">
              <% companies.each do |company| %>
                <li><%= link_to company.name, company_portal.company_scoped_root_path(company_scoped: company), class: "text-primary-600 hover:underline" %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-[var(--pu-text-muted)]">Hiring? Set up a company to post jobs.</p>
          <% end %>
        </div>
        <div class="flex gap-2 pt-2 border-t border-[var(--pu-border-muted)]">
          <%= link_to "Set up a company", main_app.new_company_setup_path, class: "pu-btn pu-btn-sm pu-btn-outline" %>
        </div>
      </div>
    </div>
  </div>
</div>
