<% profile = current_user.developer_profile %>
<% companies = current_user.companies.order(:name) %>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-[var(--pu-text)]">Hi, <%= profile&.name || current_user.email %></h1>
    <p class="text-[var(--pu-text-muted)]">Your developer profile and companies.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="pu-card">
      <div class="pu-card-body space-y-4">
        <div>
          <h3 class="font-semibold text-[var(--pu-text)]">Developer profile</h3>
          <% if profile %>
            <p class="text-sm text-[var(--pu-text-muted)]">
              @<%= profile.handle %> · <%= profile.listed? ? "Listed in the directory" : "Not listed" %>
            </p>
          <% else %>
            <p class="text-sm text-[var(--pu-text-muted)]">Show your skills, experience and projects.</p>
          <% end %>
        </div>
        <div class="flex gap-2 pt-2 border-t border-[var(--pu-border-muted)]">
          <% if profile %>
            <%= link_to "Manage profile", developer_portal_home_path(profile), class: "pu-btn pu-btn-sm pu-btn-primary" %>
          <% else %>
            <%= link_to "Create developer profile", main_app.new_developer_profile_setup_path, class: "pu-btn pu-btn-sm pu-btn-outline" %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="pu-card">
      <div class="pu-card-body space-y-4">
        <div>
          <h3 class="font-semibold text-[var(--pu-text)]">Companies</h3>
          <% if companies.any? %>
            <ul class="mt-2 space-y-1 text-sm">
              <% companies.each do |company| %>
                <li><%= link_to company.name, company_portal_home_path(company), class: "text-primary-600 hover:underline" %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-[var(--pu-text-muted)]">Hiring? Set up a company to post jobs.</p>
          <% end %>
        </div>
        <div class="flex gap-2 pt-2 border-t border-[var(--pu-border-muted)]">
          <%= link_to "Set up a company", main_app.new_company_setup_path, class: "pu-btn pu-btn-sm pu-btn-outline" %>
        </div>
      </div>
    </div>
  </div>
</div>
