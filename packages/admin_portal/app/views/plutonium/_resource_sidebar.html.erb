<%= render Plutonium::UI::Layout::IconRail.new(
      menu: Phlexi::Menu::Builder.new do |m|
        m.item "Overview", url: root_path, icon: Phlex::TablerIcons::LayoutDashboard
        m.item "Developers", url: resource_url_for(Developers::Profile, parent: nil), icon: Phlex::TablerIcons::Id
        m.item "Companies", url: resource_url_for(Company, parent: nil), icon: Phlex::TablerIcons::Building
        m.item "Skills", url: resource_url_for(Skill, parent: nil), icon: Phlex::TablerIcons::Tools
        m.item "Accounts", icon: Phlex::TablerIcons::Users do |n|
          n.item "Users", url: resource_url_for(User, parent: nil)
          n.item "Admins", url: resource_url_for(Admin, parent: nil)
        end
      end
    ) do |rail| %>
  <% rail.with_brand do %>
    <%= resource_logo_tag(classname: "h-8 w-8") %>
  <% end %>
<% end %>
